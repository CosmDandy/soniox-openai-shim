use_sops() {
  local path="${1:-$PWD/secrets.sops.yaml}"
  if ! has sops; then
    log_error "use_sops: sops не установлен"
    return 1
  fi
  if [[ ! -f $path ]]; then
    log_error "use_sops: файл не найден: $path"
    return 1
  fi
  # sops расшифровывает файл, кладёт пары в окружение и запускает в нём
  # `direnv dump`; тот печатает результат, а direnv_load его накатывает.
  # Кавычки вокруг `direnv dump` обязательны — это команда для exec-env.
  direnv_load sops exec-env "$path" 'direnv dump'
  watch_file "$path"
}

# Секреты корня
[[ -f $PWD/secrets.sops.yaml ]] && use_sops
