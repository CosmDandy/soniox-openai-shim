# The committed secrets.sops.yaml is encrypted with the age recipients in
# .sops.yaml, so it is safe in a public repo. To start from scratch:
#   cp secrets.sops.yaml.example secrets.sops.yaml && sops -e -i secrets.sops.yaml
SONIOX_API_KEY: your-soniox-api-key
# Only needed when the shim is reachable beyond localhost.
SHIM_AUTH_TOKEN: generate-with-openssl-rand-base64-32
